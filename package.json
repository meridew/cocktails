{
  "name": "cocktails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:lan": "vite dev --host",
    "build": "vite build",
    "preview": "npm run build && node build/index.js",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "node scripts/db.js reset",
    "db:seed": "node scripts/db.js seed",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "^5.1.0",
    "@fontsource/bungee": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.2.6",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^24.13.3",
    "@types/web-push": "^3.6.4",
    "canvas-confetti": "^1.9.3",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
