node_modules/
dist/
dev-dist/
build/
# capacitor-assets PWA output — unused (vite-plugin-pwa owns the web manifest + icons)
/apps/web/public/manifest.webmanifest
/apps/web/icons/
*.tsbuildinfo
.env
.env.*
!.env.example
!.env.native
# Anchored: this is the SQLite database at ./data/, nothing else. Unanchored it
# matches a directory named `data` at ANY depth, which silently swallowed
# src/lib/shared/data/cocktails.json — the entire recipe dataset — and only a
# clean checkout on another machine revealed it.
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.DS_Store
*.local

# SvelteKit generated output
.svelte-kit/
build/

# The Graph certificate is handed over out-of-band, not carried here. Its
# private half lives only on the Mac at ~/.config/cocktails/graph-key.pem.
graph-cert.pem
