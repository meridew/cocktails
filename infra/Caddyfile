# Single internal entry point — the "Cloudflare-ready seam".
# Today: router port-forward → this Caddy (plain HTTP internally).
# Later:  cloudflared → this Caddy (HTTPS terminated at Cloudflare's edge).
# Either way, web + api never change.
:80 {
	encode gzip zstd

	# Security headers. The origin is public via the Cloudflare tunnel and holds a
	# staff session token in localStorage, so a script-injection foothold or a
	# framing attack would be costly. TLS terminates at Cloudflare's edge, so HSTS
	# is set there rather than here.
	header {
		# Self-hosted assets only. 'unsafe-inline' for style-src is required by
		# Svelte's scoped-style injection; script-src stays strict.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		# Nothing here needs these device APIs.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}

	# API → the Hono/Node service
	handle /api/* {
		reverse_proxy api:8787
	}

	# Everything else → the static Svelte PWA (nginx)
	handle {
		reverse_proxy web:80
	}
}
