{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cocktails",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5180
    },
    {
      "comment": "Serves the real production build (apps/web/dist) so the PWA service worker and offline behaviour can be tested. Run `npm -w @cocktails/web run build` first.",
