      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "-w",
        "@cocktails/web",
        "run",
        "preview",
        "--",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190
    },
    {
      "name": "Static site (legacy flat app, python)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    }
  ]
}
